{% extends 'layouts/application.html.twig' %}

{% set stream = stream_view.stream %}

{% block title %}{{ stream.name }}{% endblock %}
{% block canonical %}{{ url_full('stream', { id: stream.id }) }}{% endblock %}

{% block head_additional_tags %}
    {# Changing the filters refreshes the whole page. Morphing preserves the
     # focus and the scroll positions across these refreshes. #}
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
{% endblock %}

{% block layout_header %}
    {{ include('layouts/_header.html.twig', { page: 'stream', tab: 'reading' }) }}
{% endblock %}

{% block layout_sidenav %}
    {{ include('layouts/_sidenav.html.twig', { navigation: reading_navigation(current: stream.id) }) }}
{% endblock %}

{% block back %}
    {{ include('layouts/_back.html.twig', { title: stream.name, reset: true }) }}
{% endblock %}

{% block body %}
    <div class="cols cols--gap-large">
        <div class="col--size2 text--center">
            {% if can(app.user, 'update', stream) %}
                <button
                    class="button--edit-image"
                    data-controller="modal-opener"
                    data-action="modal-opener#fetch"
                    data-modal-opener-href-value="{{ url('edit image stream', { id: stream.id }) }}"
                    aria-haspopup="dialog"
                    aria-controls="modal"
                    title="{{ t('Change the illustration') }}"
                >
                    <img
                        class="illustration illustration--alt"
                        alt=""
                        src="{{ url_media('covers', stream.image_filename, 'stream-card.png') }}"
                    >

                    <span class="sr-only">
                        {{ t('Change the illustration') }}
                    </span>
                </button>
            {% else %}
                <img
                    class="illustration illustration--alt"
                    alt=""
                    src="{{ url_media('covers', stream.image_filename, 'stream-card.png') }}"
                >
            {% endif %}
        </div>

        <div class="col--extend flow">
            <h1 class="text--break">{{ stream.name }}</h1>

            <p class="stack stack--gap">
                <span title="{{ t('Publication frequency') }}">
                    {{ icon('frequency') }}
                    {{ stream.publicationFrequencyPerYear({ context_user: app.user }) | format_publication_frequency }}
                </span>

                {% set sources = stream.sources({ context_user: app.user }) %}

                <a href="{{ url('stream sources', { id: stream.id }) }}">
                    {{ icon('feed') }}
                    {{ t('%d source', '%d sources', sources | length, [sources | length]) }}
                </a>
            </p>

            <p>
                {{ t('By') }}
                <a class="username" href="{{ url('profile', { id: stream.owner.id }) }}">
                    <img class="avatar avatar--mini" alt="" src="{{ url_avatar(stream.owner.avatar_filename) }}">
                    {{- stream.owner.username -}}
                </a>
            </p>

            {% if stream.description %}
                <div class="text-container">
                    {{ stream.descriptionAsHtml | raw }}
                </div>
            {% endif %}
        </div>
    </div>

    {% if can(app.user, 'update', stream) %}
        <div class="panel panel--rounded stack stack--gap-small">
            <a class="button" href="{{ url('edit stream sources', { id: stream.id }) }}">
                {{ t('Manage sources') }}
            </a>

            <button
                data-controller="modal-opener"
                data-action="modal-opener#fetch"
                data-modal-opener-href-value="{{ url('edit stream', { id: stream.id }) }}"
                aria-haspopup="dialog"
                aria-controls="modal"
            >
                {{ icon('pencil') }}
                {{ t('Edit') }}
            </button>

            {% if can(app.user, 'delete', stream) %}
                {% embed 'components/popup.html.twig' %}
                    {% block opener %}
                        {{ icon('menu') }}
                        {{ t('Actions') }}
                    {% endblock %}

                    {% block items %}
                        {% import _self as item %}

                        {{ item.action(
                            url: url('delete stream', { id: stream.id }),
                            label: t('Delete'),
                            icon: 'trash',
                            csrf: 'streams\\DeleteStream',
                            confirm: t('Are you sure that you want to delete this stream?'),
                        ) }}
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>
    {% endif %}

    <div class="flow flow--large" data-controller="stream">
        {{ include('streams/_filters.html.twig') }}

        {{ include('streams/_timeline.html.twig') }}
    </div>
{% endblock %}
