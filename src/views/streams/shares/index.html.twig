{% extends 'layouts/modal.html.twig' %}

{% block title %}{{ t('Sharing access to “%s”', [stream.name]) }}{% endblock %}

{% block body %}
    <div class="flow flow--larger">
        <p class="text--center">
            {% if stream.is_public %}
                {{ t('This stream is public, anyone can access it.') }}
            {% else %}
                {{ t('This stream is private, you can share access to other users.') }}
            {% endif %}
        </p>

        <form method="post" action="{{ url('share stream', { id: stream.id }) }}" class="flow">
            {{ include('alerts/_error.html.twig', { message: form.error('@base') }) }}

            <div class="form-group">
                <label for="user-id">
                    {{ t('Share access with') }}
                </label>

                {% if form.isInvalid('user_id') %}
                    <p id="user-id-error" class="form-group__error">
                        {{ t('Error:') }}
                        {{ form.error('user_id') }}
                    </p>
                {% endif %}

                <div class="cols cols--always cols--gap-smaller">
                    <input
                        id="user-id"
                        name="user_id"
                        type="text"
                        required
                        value="{{ form.user_id }}"
                        aria-describedby="user-id-caption"
                        placeholder="{{ url_full('profile', { id: app.user.id }) }}"
                        {% if form.isInvalid('user_id') %}
                            aria-errormessage="user-id-error"
                            aria-invalid="true"
                        {% endif %}
                    >

                    <button type="submit" class="button--primary">
                        {{ t('Share') }}
                    </button>
                </div>

                <p id="user-id-caption" class="form-group__caption">
                    {{ t('Copy and paste the <abbr>URL</abbr> of a user’s profile.') | raw }}
                    {{ t('They will see the sources and links they already have access to, and will be able to create their own views.') }}
                </p>
            </div>

            <input type="hidden" name="csrf_token" value="{{ csrf_token(form) }}">
        </form>

        {% set stream_shares = stream.shares %}
        {% if stream_shares %}
            <div class="flow">
                <h2>{{ t('Shared with:') }}</h2>

                <ul class="list list--nostyle">
                    {% for stream_share in stream_shares %}
                        {% set user = stream_share.user %}
                        <li class="list__item cols cols--always cols--center cols--gap">
                            <span class="col--extend">
                                <a class="username" href="{{ url('profile', { id: user.id }) }}">
                                    <img class="avatar avatar--mini" src="{{ url_avatar(user.avatar_filename) }}" alt="">
                                    {{ user.username }}
                                </a>
                            </span>

                            <form class="line__item" method="post" action="{{ url('unshare stream', { id: stream.id }) }}">
                                <button type="submit" class="button--small button--icon-mobile">
                                    {{ icon('times') }}

                                    <span class="no-mobile">
                                        {{ t('Revoke') }}
                                    </span>
                                </button>

                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\UnshareStream') }}">
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </div>
{% endblock %}
