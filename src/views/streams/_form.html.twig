<form
    method="post"
    action="{{ action }}"
    data-controller="autosave"
    data-action="turbo:submit-start@document->autosave#clear"
    class="flow"
>
    {{ include('alerts/_error.html.twig', { message: form.error('@base') }) }}

    <div class="form-group">
        <label for="name">
            {{ t('What’s the name of the stream?') }}
            <span class="label__help">
                {{ t('(max. %d characters)', [form.stream_name_max_length]) }}
            </span>
        </label>

        {% if form.isInvalid('name') %}
            <p id="name-error" class="form-group__error">
                {{ t('Error:') }}
                {{ form.error('name') }}
            </p>
        {% endif %}

        <input
            id="name"
            name="name"
            type="text"
            required
            value="{{ form.name }}"
            autofocus
            maxlength="{{ form.stream_name_max_length }}"
            data-action="keyup->autosave#save"
            {% if form.isInvalid('name') %}
                aria-errormessage="name-error"
                aria-invalid="true"
            {% endif %}
        />
    </div>

    {{ include('components/text_editor.html.twig', {
        form: form,
        name: 'description',
        label: t('What’s the purpose of the stream?'),
        label_help: t('(optional)'),
        caption: t('You can format the description in Markdown.'),
    }) }}

    <div>
        <input
            type="checkbox"
            id="is_public"
            name="is_public"
            {{ form.is_public ? 'checked' : '' }}
        >

        <label for="is_public">
            {{ t('Show the stream publicly') }}
        </label>
    </div>

    <div>
        <input
            type="checkbox"
            id="display-unread-in-sidenav"
            name="display_unread_in_sidenav"
            aria-describedby="display-unread-in-sidenav-caption"
            {{ form.display_unread_in_sidenav ? 'checked' : '' }}
        >

        <label for="display-unread-in-sidenav">
            {{ t('Flag unread links in the reading menu') }}
        </label>

        <p class="form-group__caption" id="display-unread-in-sidenav-caption">
            {{ t('A dot is displayed next to the stream when it contains unread links from the last seven days.') }}
        </p>
    </div>

    <div class="text--center">
        <button type="submit" class="button--primary button--big">
            {{ submit_label }}
        </button>
    </div>

    <input type="hidden" name="csrf_token" value="{{ csrf_token(form) }}" />
</form>
