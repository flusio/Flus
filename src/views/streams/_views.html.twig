<div class="flow flow--smaller">
    <div class="views">
        {% embed 'components/scroller.html.twig' with {
            previous_label: t('Display the previous views'),
            next_label: t('Display the next views'),
            class: 'views__scroller',
            strip_class: 'views__strip',
            strip_label: t('Views'),
        } %}
            {% block strip %}
                {% for view in stream.views({ context_user: app.user }) %}
                    <a
                        id="stream-view-{{ view.routeId }}"
                        class="button views__view"
                        href="{{ view.is_default ? url('stream', { id: stream.id }) : url('stream', { id: stream.id, view: view.id }) }}"
                        {% if stream_view.isViewSelected(view) %}aria-current="true"{% endif %}
                        data-turbo-action="replace"
                    >
                        {{ view.name }}
                    </a>
                {% endfor %}

                <button
                    type="button"
                    id="stream-view-new"
                    class="views__view views__view--new"
                    data-controller="modal-opener"
                    data-action="modal-opener#fetch"
                    data-modal-opener-href-value="{{ url('new stream view', { id: stream.id }) }}"
                    aria-haspopup="dialog"
                    aria-controls="modal"
                >
                    {{ icon('plus') }}
                    {{ t('New view') }}
                </button>
            {% endblock %}
        {% endembed %}

        {% embed 'components/popup.html.twig' with {
            position: 'right',
            opener_class: 'button button--icon',
            tooltip: t('View actions'),
        } %}
            {% block opener %}
                {{ icon('menu') }}

                <span class="sr-only">{{ t('View actions') }}</span>
            {% endblock %}

            {% block items %}
                {% import _self as item %}

                {{ item.modal(
                    url: url('edit stream view', { id: stream.id, view_id: stream_view.view.routeId }),
                    label: t('Rename the view'),
                    icon: 'pencil',
                ) }}

                {% if stream_view.view.isPersisted %}
                    {{ item.separator() }}

                    {{ item.action(
                        url: url('delete stream view', { id: stream.id, view_id: stream_view.view.routeId }),
                        label: stream_view.view.is_default ? t('Reset the view') : t('Delete the view'),
                        icon: 'trash',
                        csrf: 'views\\DeleteView',
                        confirm: stream_view.view.is_default
                            ? t('Are you sure that you want to reset the main view?')
                            : t('Are you sure that you want to delete this view?'),
                    ) }}
                {% endif %}
            {% endblock %}
        {% endembed %}
    </div>

    <form
        method="get"
        action=""
        class="filters"
        data-stream-target="formFilters"
        data-action="submit->stream#submitForm"
    >
        <details
            open
            data-controller="details morph"
            data-details-storage-key-value="stream-filters"
            data-morph-preserve-value="open data-details-collapsed-value"
            data-action="turbo:before-morph-attribute->morph#preserveAttributes"
        >
            <summary
                class="details__header cols cols--always cols--center cols--gap-small"
                data-action="click->details#toggle"
            >
                {{ icon('angle-down', 'details__chevron') }}

                <span class="col--extend text--bold">{{ t('View filters') }}</span>
            </summary>

            <div class="filters__section flow">
                {% set max_count_per_day = stream_view.maxCountPerDay() %}

                {# Number of days displayed per month, used to cap the width of each
                 # month label so it cannot overflow onto the next month's label. #}
                {% set count_days_per_month = {} %}
                {% for day in stream_view.period %}
                    {% set month_key = day.format('Y-m') %}
                    {% set count = count_days_per_month[month_key] | default(0) %}
                    {% set count_days_per_month = count_days_per_month | merge({ (month_key): count + 1 }) %}
                {% endfor %}

                {% embed 'components/scroller.html.twig' with {
                    previous_label: t('Display the previous days'),
                    next_label: t('Display the next days'),
                    strip_class: 'day-picker',
                    strip_label: t('Date'),
                    navigable: true,
                    actions: 'details:opened@document->scroller#reveal',
                } %}
                    {% block strip %}
                        {% for day in stream_view.period %}
                            {% set day_value = day.format('Y-m-d') %}
                            {% set is_month_first_day = loop.first or day.format('Y-m') != stream_view.period[loop.index0 - 1].format('Y-m') %}
                            {% set day_count = stream_view.countByDay(day) %}
                            {% set day_count_unread = stream_view.countUnreadByDay(day) %}
                            {% set day_title = t('%s: %d link', '%s: %d links', day_count, [d(day), day_count]) %}
                            {% if day_count_unread > 0 %}
                                {% set day_title = day_title ~ ' ' ~ t('(%d unread)', '(%d unread)', day_count_unread, [day_count_unread]) %}
                            {% endif %}

                            {% if is_month_first_day %}
                                {% set count_month_days = count_days_per_month[day.format('Y-m')] %}

                                <span class="day-picker__month-anchor">
                                    <span
                                        class="day-picker__month"
                                        style="max-width: calc({{ count_month_days }} * var(--day-width));"
                                    >
                                        {# Abbreviate for narrow months so we avoid truncating the name with an ellipsis. #}
                                        {% if count_month_days == 1 %}
                                            {{ d(day, 'MMM') }}
                                        {% elseif count_month_days == 2 %}
                                            {{ d(day, 'MMM y') }}
                                        {% else %}
                                            {{ d(day, 'MMMM y') }}
                                        {% endif %}
                                    </span>
                                </span>
                            {% endif %}

                            <button
                                type="button"
                                class="day-picker__day {{ stream_view.isInRange(day) ? 'day-picker__day--in-range' : '' }} {{ day.format('j') == '1' ? 'day-picker__day--month-start' : '' }}"
                                id="stream-at-{{ day_value }}"
                                value="{{ day_value }}"
                                title="{{ day_title }}"
                                aria-pressed="{{ stream_view.isAt(day) ? 'true' : 'false' }}"
                                tabindex="{{ stream_view.isAt(day) ? '0' : '-1' }}"
                                data-stream-target="at"
                                data-scroller-target="item"
                                data-action="stream#selectAt"
                            >
                                <span class="day-picker__count">
                                    {{ day_count }}
                                </span>

                                <span class="day-picker__chart" aria-hidden="true">
                                    <span
                                        class="day-picker__bar {{ day_count == 0 ? 'day-picker__bar--empty' : '' }}"
                                        style="--total-ratio: {{ max_count_per_day > 0 ? day_count / max_count_per_day : 0 }};"
                                    >
                                        {% if day_count_unread > 0 %}
                                            <span
                                                class="day-picker__bar-unread"
                                                style="--unread-ratio: {{ day_count_unread / day_count }};"
                                            ></span>
                                        {% endif %}
                                    </span>
                                </span>

                                <span class="day-picker__weekday">
                                    {{ d(day, 'EEE') }}
                                </span>

                                <span class="day-picker__number">
                                    {{ day.format('j') }}
                                </span>
                            </button>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}

                <div
                    class="stack stack--gap-small"
                    role="group"
                    aria-label="{{ t('Period') }}"
                >
                    {% for number_of_days in [1, 3, 7] %}
                        <div class="filters__option">
                            <button
                                type="button"
                                value="{{ number_of_days }}"
                                aria-pressed="{{ stream_view.days == number_of_days ? 'true' : 'false' }}"
                                data-stream-target="days"
                                data-action="stream#selectDays"
                            >
                                {{ t('%d day', '%d days', number_of_days, [number_of_days]) }}
                            </button>
                        </div>
                    {% endfor %}
                </div>

            </div>

            <div class="filters__section">
                <div class="cols cols--gap-small cols--center">
                    <label class="col--size2" for="stream-filter-query">
                        {{ t('Keywords') }}
                    </label>

                    <input
                        id="stream-filter-query"
                        class="col--size10"
                        type="search"
                        name="q"
                        value="{{ stream_view.query }}"
                        autocomplete="off"
                        placeholder="{{ t('Words or URL') }}"
                        data-controller="morph"
                        data-action="
                            input->stream#searchQuery
                            search->stream#submitForm
                            turbo:before-morph-attribute->morph#preserveTypedValue
                        "
                    >
                </div>
            </div>

            <div class="filters__section">
                <div class="cols cols--gap-small cols--center">
                    <p class="col--size2 text--bold" id="stream-filter-status-label">
                        {{ t('Reading status') }}
                    </p>

                    <div class="col--size10 flow flow--small">
                        <div
                            class="stack stack--gap-small"
                            role="group"
                            aria-labelledby="stream-filter-status-label"
                        >
                            {% for status, label in {
                                'all': t('All'),
                                'unread': t('Unread'),
                                'read-later': t('To read'),
                                'read': t('Links read'),
                            } %}
                                <div class="filters__option">
                                    <button
                                        type="button"
                                        value="{{ status }}"
                                        aria-pressed="{{ stream_view.isStatusSelected(status) ? 'true' : 'false' }}"
                                        data-stream-target="status"
                                        data-action="stream#selectStatus"
                                    >
                                        {{ label }}
                                    </button>
                                </div>
                            {% endfor %}

                            <div class="cols cols--always cols--center">
                                {# A checkbox submits nothing when unchecked: this hidden input
                                 # makes "with_dismissed" always present, so that its absence can
                                 # never pass for "unchecked". It must come first, as the later
                                 # value is the one that wins. #}
                                <input type="hidden" name="with_dismissed" value="">

                                <input
                                    type="checkbox"
                                    id="stream-filter-with-dismissed"
                                    name="with_dismissed"
                                    value="1"
                                    {{ stream_view.with_dismissed ? 'checked' : '' }}
                                    data-action="change->stream#submit"
                                >

                                <label for="stream-filter-with-dismissed">
                                    {{ t('Include the ignored links') }}
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="filters__section flow flow--small">
                {% set sources_and_counts = stream_view.countedSources() %}

                <p class="text--bold" id="stream-filter-sources-label">
                    {{ t('Sources (%d)', [sources_and_counts | length]) }}
                </p>

                {% if sources_and_counts %}
                    <div
                        class="stack stack--gap-small"
                        role="group"
                        aria-labelledby="stream-filter-sources-label"
                    >
                        {% for source_and_count in sources_and_counts %}
                            {% set source = source_and_count[0] %}
                            {% set count_links = source_and_count[1] %}
                            {% set source_title = t('%s: %d link', '%s: %d links', count_links, [source.name, count_links]) %}

                            <div class="filters__option filters__option--light">
                                <button
                                    type="button"
                                    class="cols cols--always cols--center cols--gap-small"
                                    id="stream-source-{{ source.id }}"
                                    value="{{ source.id }}"
                                    aria-pressed="{{ stream_view.isSourceSelected(source) ? 'true' : 'false' }}"
                                    title="{{ source_title }}"
                                    data-stream-target="source"
                                    data-action="stream#selectSource"
                                >
                                    <img
                                        class="filters__option-image"
                                        alt=""
                                        src="{{ url_media('covers', source.image_filename, 'collection-card.png') }}"
                                    >

                                    <span class="filters__option-label">
                                        {{ source.name }}
                                    </span>

                                    <span class="filters__option-count">
                                        {{ count_links }}
                                    </span>

                                    <span class="filters__option-unselect">
                                        {{ icon('times') }}
                                    </span>
                                </button>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <div class="filters__section text--right">
                {% if stream_view.view.isModified %}
                    {% embed 'components/popup.html.twig' with {
                        position: 'right',
                    } %}
                        {% block opener %}
                            {{ t('Save view') }}
                            {{ icon('angle-down') }}
                        {% endblock %}

                        {% block items %}
                            {% import _self as item %}

                            {{ item.action(
                                url: url('save stream view', { id: stream.id, view_id: stream_view.view.routeId }),
                                label: t('Save to current view'),
                                icon: 'check',
                                form: 'save-stream-view',
                            ) }}

                            {{ item.modal(
                                url: url('new stream view', stream_view.view.current_url_parameters | merge({ id: stream_view.stream.id })),
                                label: t('Save changes to new view'),
                                icon: 'plus',
                            ) }}
                        {% endblock %}
                    {% endembed %}
                {% else %}
                    <button type="button" disabled>
                        {{ t('Save view') }}
                        {{ icon('angle-down') }}
                    </button>
                {% endif %}
            </div>
        </details>

        {# The dates, days, sources and statuses are toggle buttons: these inputs
         # are what actually carry their values in the submitted query. #}
        <input
            type="hidden"
            name="at"
            value="{{ stream_view.at.format('Y-m-d') }}"
            data-stream-target="atInput"
        >

        <input
            type="hidden"
            name="days"
            value="{{ stream_view.days }}"
            data-stream-target="daysInput"
        >

        {# The source is read from the view, not from stream_view.source: the
         # latter is null when the source has no link under the current
         # filters, and the view must not lose its source on submit. #}
        <input
            type="hidden"
            name="source"
            value="{{ stream_view.view.current_url_parameters['source'] }}"
            data-stream-target="sourceInput"
        >

        <input
            type="hidden"
            name="status"
            value="{{ stream_view.status }}"
            data-stream-target="statusInput"
        >

        {% if stream_view.view.isPersisted %}
            <input
                type="hidden"
                name="view"
                value="{{ stream_view.view.id }}"
            >
        {% endif %}
    </form>

    {# The target of the "Save to current view" button of the save menu, which
     # lives inside the GET form above where a POST form cannot be nested. #}
    <form
        id="save-stream-view"
        method="post"
        action="{{ url('save stream view', { id: stream.id, view_id: stream_view.view.routeId }) }}"
        data-turbo-preserve-scroll
    >
        {% for param_name, param_value in stream_view.view.current_url_parameters %}
            <input type="hidden" name="{{ param_name }}" value="{{ param_value }}">
        {% endfor %}

        <input type="hidden" name="csrf_token" value="{{ csrf_token('views\\SaveView') }}">
    </form>
</div>
