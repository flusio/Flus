{% set links_timeline = stream_view.linksTimeline() %}

{# The "aria-busy" attribute is set by the stream controller while a filter
 # change is in flight, to dim the timeline (cf. the timelines stylesheet). #}
<div id="stream-timeline" data-stream-target="timeline">
    {% if not links_timeline.empty %}
        <div class="flow flow--large">
            <div class="flow flow--large" data-controller="zindex-inverser">
                {% for date_group in links_timeline.datesGroups %}
                    <section class="group flow">
                        <header class="group__header" data-zindex-inverser-target="item">
                            <h2 class="group__title">
                                {{ d(date_group.date, 'dd MMMM') }}
                            </h2>

                            <div class="group__separator"></div>

                            <details
                                class="popup"
                                data-controller="popup"
                                data-action="toggle->popup#update click@window->popup#closeOnClickOutside keydown->popup#closeOnEscape"
                            >
                                <summary class="popup__opener">
                                    <span class="button button--icon-mobile">
                                        {{ icon('menu') }}

                                        <span class="no-mobile">
                                            {{ t('Actions') }}
                                        </span>
                                    </span>
                                </summary>

                                <nav class="popup__container popup__container--right" role="menu">
                                    <div class="popup__title">{{ t('Actions on the day') }}</div>

                                    <form method="post" action="{{ url('mark stream as read', { id: stream.id }) }}" role="menuitem">
                                        <button class="popup__item popup__item--button">
                                            {{ icon('check') }}
                                            {{ t('Mark all as read') }}
                                        </button>

                                        <input type="hidden" name="at" value="{{ date_group.date.format('Y-m-d') }}">
                                        <input type="hidden" name="days" value="1">
                                        <input type="hidden" name="source" value="{{ stream_view.source ? stream_view.source.id : '' }}">
                                        <input type="hidden" name="status" value="{{ stream_view.status }}">
                                        <input type="hidden" name="before" value="{{ stream_view.rendered_at.format('Y-m-d H:i:sP') }}">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\MarkStreamAsRead') }}">
                                    </form>

                                    <form method="post" action="{{ url('read stream later', { id: stream.id }) }}" role="menuitem">
                                        <button class="popup__item popup__item--button">
                                            {{ icon('bookmark') }}
                                            {{ t('Read the links later') }}
                                        </button>

                                        <input type="hidden" name="at" value="{{ date_group.date.format('Y-m-d') }}">
                                        <input type="hidden" name="days" value="1">
                                        <input type="hidden" name="source" value="{{ stream_view.source ? stream_view.source.id : '' }}">
                                        <input type="hidden" name="status" value="{{ stream_view.status }}">
                                        <input type="hidden" name="before" value="{{ stream_view.rendered_at.format('Y-m-d H:i:sP') }}">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\MarkStreamAsReadLater') }}">
                                    </form>

                                    <div class="popup__separator"></div>

                                    <form
                                        method="post"
                                        action="{{ url('dismiss stream', { id: stream.id }) }}"
                                        data-turbo-confirm="{{ t('The links will no longer be counted as unread and won’t be suggested in your news. Are you sure?') }}"
                                        role="menuitem"
                                    >
                                        <button class="popup__item popup__item--button">
                                            {{ icon('times') }}
                                            {{ t('Ignore the links') }}
                                        </button>

                                        <input type="hidden" name="at" value="{{ date_group.date.format('Y-m-d') }}">
                                        <input type="hidden" name="days" value="1">
                                        <input type="hidden" name="source" value="{{ stream_view.source ? stream_view.source.id : '' }}">
                                        <input type="hidden" name="status" value="{{ stream_view.status }}">
                                        <input type="hidden" name="before" value="{{ stream_view.rendered_at.format('Y-m-d H:i:sP') }}">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\MarkStreamAsDismissed') }}">
                                    </form>
                                </nav>
                            </details>
                        </header>

                        <div class="group__body flow">
                            {% set links = date_group.links %}

                            {% if links %}
                                <div class="grid">
                                    {% for link in date_group.links %}
                                        {{ include('links/_link.html.twig', {
                                            link: link,
                                            display_read_later: 'auto',
                                            display_mark_as_read: 'auto',
                                            storing_must_mark_as_read: true,
                                        })}}
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% for source_group in date_group.sourceGroups %}
                                <div class="source-group flow flow--small">
                                    <div class="source-group__header cols cols--always cols--gap cols--center">
                                        <h3 class="source-group__title">
                                            {{ source_group.source.name() }}
                                        </h3>

                                        <span class="col--noshrink text--secondary">
                                            {{ t('%s link', '%s links', source_group.links | length, [source_group.links | length]) }}
                                        </span>

                                        <details
                                            class="popup"
                                            data-controller="popup"
                                            data-action="toggle->popup#update click@window->popup#closeOnClickOutside keydown->popup#closeOnEscape"
                                        >
                                            <summary class="popup__opener">
                                                <span class="button button--icon button-ghost">
                                                    {{ icon('menu') }}

                                                    <span class="sr-only">
                                                        {{ t('Actions') }}
                                                    </span>
                                                </span>
                                            </summary>

                                            <nav class="popup__container popup__container--center" role="menu">
                                                <div class="popup__title">{{ t('Actions on the feed') }}</div>

                                                <form data-turbo-preserve-scroll method="post" action="{{ url('mark stream as read', { id: stream.id }) }}" role="menuitem">
                                                    <button class="popup__item popup__item--button">
                                                        {{ icon('check') }}
                                                        {{ t('Mark all as read') }}
                                                    </button>

                                                    <input type="hidden" name="at" value="{{ date_group.date.format('Y-m-d') }}">
                                                    <input type="hidden" name="days" value="1">
                                                    <input type="hidden" name="source" value="{{ source_group.source.id }}">
                                                    <input type="hidden" name="status" value="{{ stream_view.status }}">
                                                    <input type="hidden" name="before" value="{{ stream_view.rendered_at.format('Y-m-d H:i:sP') }}">
                                                    <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\MarkStreamAsRead') }}">
                                                </form>

                                                <form data-turbo-preserve-scroll method="post" action="{{ url('read stream later', { id: stream.id }) }}" role="menuitem">
                                                    <button class="popup__item popup__item--button">
                                                        {{ icon('bookmark') }}
                                                        {{ t('Read the links later') }}
                                                    </button>

                                                    <input type="hidden" name="at" value="{{ date_group.date.format('Y-m-d') }}">
                                                    <input type="hidden" name="days" value="1">
                                                    <input type="hidden" name="source" value="{{ source_group.source.id }}">
                                                    <input type="hidden" name="status" value="{{ stream_view.status }}">
                                                    <input type="hidden" name="before" value="{{ stream_view.rendered_at.format('Y-m-d H:i:sP') }}">
                                                    <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\MarkStreamAsReadLater') }}">
                                                </form>

                                                <div class="popup__separator"></div>

                                                <form
                                                    data-turbo-preserve-scroll
                                                    method="post"
                                                    action="{{ url('dismiss stream', { id: stream.id }) }}"
                                                    data-turbo-confirm="{{ t('The links will no longer be counted as unread and won’t be suggested in your news. Are you sure?') }}"
                                                    role="menuitem"
                                                >
                                                    <button class="popup__item popup__item--button">
                                                        {{ icon('times') }}
                                                        {{ t('Ignore the links') }}
                                                    </button>

                                                    <input type="hidden" name="at" value="{{ date_group.date.format('Y-m-d') }}">
                                                    <input type="hidden" name="days" value="1">
                                                    <input type="hidden" name="source" value="{{ source_group.source.id }}">
                                                    <input type="hidden" name="status" value="{{ stream_view.status }}">
                                                    <input type="hidden" name="before" value="{{ stream_view.rendered_at.format('Y-m-d H:i:sP') }}">
                                                    <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\MarkStreamAsDismissed') }}">
                                                </form>
                                            </nav>
                                        </details>
                                    </div>

                                    <div class="source-group__body grid">
                                        {% for link in source_group.links %}
                                            {{ include('links/_link.html.twig', {
                                                link: link,
                                                display_read_later: 'auto',
                                                display_mark_as_read: 'auto',
                                                storing_must_mark_as_read: true,
                                            }) }}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                {% endfor %}
            </div>

            <div class="text--center">
                <details
                    class="popup"
                    data-controller="popup"
                    data-action="toggle->popup#update click@window->popup#closeOnClickOutside keydown->popup#closeOnEscape"
                >
                    <summary class="popup__opener">
                        <span class="button button--primary button--big">
                            {{ icon('menu') }}
                            {{ t('Actions') }}
                        </span>
                    </summary>

                    <nav class="popup__container popup__container--center popup__container--top" role="menu">
                        <div class="popup__title">{{ t('Actions on the links') }}</div>

                        <form method="post" action="{{ url('mark stream as read', { id: stream.id }) }}" role="menuitem">
                            <button class="popup__item popup__item--button">
                                {{ icon('check') }}
                                {{ t('Mark all as read') }}
                            </button>

                            <input type="hidden" name="at" value="{{ stream_view.at.format('Y-m-d') }}">
                            <input type="hidden" name="days" value="{{ stream_view.days }}">
                            <input type="hidden" name="source" value="{{ stream_view.source ? stream_view.source.id : '' }}">
                            <input type="hidden" name="status" value="{{ stream_view.status }}">
                            <input type="hidden" name="before" value="{{ stream_view.rendered_at.format('Y-m-d H:i:sP') }}">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\MarkStreamAsRead') }}">
                        </form>

                        <form method="post" action="{{ url('read stream later', { id: stream.id }) }}" role="menuitem">
                            <button class="popup__item popup__item--button">
                                {{ icon('bookmark') }}
                                {{ t('Read the links later') }}
                            </button>

                            <input type="hidden" name="at" value="{{ stream_view.at.format('Y-m-d') }}">
                            <input type="hidden" name="days" value="{{ stream_view.days }}">
                            <input type="hidden" name="source" value="{{ stream_view.source ? stream_view.source.id : '' }}">
                            <input type="hidden" name="status" value="{{ stream_view.status }}">
                            <input type="hidden" name="before" value="{{ stream_view.rendered_at.format('Y-m-d H:i:sP') }}">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\MarkStreamAsReadLater') }}">
                        </form>

                        <div class="popup__separator"></div>

                        <form
                            method="post"
                            action="{{ url('dismiss stream', { id: stream.id }) }}"
                            data-turbo-confirm="{{ t('The links will no longer be counted as unread and won’t be suggested in your news. Are you sure?') }}"
                            role="menuitem"
                        >
                            <button class="popup__item popup__item--button">
                                {{ icon('times') }}
                                {{ t('Ignore the links') }}
                            </button>

                            <input type="hidden" name="at" value="{{ stream_view.at.format('Y-m-d') }}">
                            <input type="hidden" name="days" value="{{ stream_view.days }}">
                            <input type="hidden" name="source" value="{{ stream_view.source ? stream_view.source.id : '' }}">
                            <input type="hidden" name="status" value="{{ stream_view.status }}">
                            <input type="hidden" name="before" value="{{ stream_view.rendered_at.format('Y-m-d H:i:sP') }}">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\MarkStreamAsDismissed') }}">
                        </form>
                    </nav>
                </details>
            </div>
        </div>
    {% else %}
        <p class="panel panel--grey panel--rounded panel--larger text--bolder text--center">
            {{ t('There is no link matching your filters.') }}
        </p>
    {% endif %}
</div>
