{% set action = action ?? null %}
{% set focused_source_id = focused_source_id ?? null %}

{% set count_streams = app.user ? source.countStreamsByUser(app.user) : 0 %}

{% set flags = [
    count_streams ? '' : 'without-stream',
    source.isFeed ? 'type-feed' : 'type-collection',
    'frequency-' ~ source.publicationFrequencyGroup,
] %}

{# A source can be searched by everything that is displayed about it: its name,
 # and the website of a feed or the publishers of a collection. #}
{% if source.isFeed %}
    {% set search_terms = [source.name, source.feedWebsiteHost] %}
{% else %}
    {% set search_terms = [source.name] | merge(source.publishers | column('username')) %}
{% endif %}

<article
    id="source-{{ source.id }}"
    class="source cols cols--center cols--gap"
    tabindex="-1"
    data-filter-target="item"
    data-focus-target="{{ source.id == focused_source_id ? 'item autofocus' : 'item' }}"
    data-search="{{ search_terms | json_encode }}"
    data-flags="{{ flags | join(' ') }}"
>
    <div class="col--extend cols cols--always cols--center cols--gap">
        <a
            class="source__image-container col--noshrink"
            tabindex="-1"
            href="{{ url('collection', { id: source.id }) }}"
        >
            <img
                class="source__image"
                alt=""
                src="{{ url_media('covers', source.image_filename, 'collection-card.png') }}"
            >
        </a>

        <div class="source__content col--extend flow flow--smaller">
            <h3 class="text--bold text--normal">
                <a class="anchor--nostyle" href="{{ url('collection', { id: source.id }) }}">
                    {{ source.name }}
                </a>
            </h3>

            <p class="text--secondary">
                {% if source.isFeed %}
                    <span title="{{ t('Feed of %s website', [source.feedWebsiteHost]) }}">
                        {{ source.feedWebsiteHost }}
                    </span>
                {% else %}
                    {{ t('By') }}
                    {%- for user in source.publishers -%}
                        {% if not loop.first %}, {% endif %}
                        <a class="username" href="{{ url('profile', { id: user.id }) }}">
                            <img class="avatar avatar--mini" alt="" src="{{ url_avatar(user.avatar_filename) }}">
                            {{- user.username -}}
                        </a>
                    {%- endfor -%}
                {% endif %}
            </p>

            <p class="source__details">
                <span title="{{ t('Publication frequency') }}">
                    {{ icon('frequency') }}
                    {{ source.publication_frequency_per_year | format_publication_frequency }}
                </span>

                {% if can(app.user, 'update', stream) %}
                    <span title="{{ t('Streams displaying this source') }}">
                        {{ icon('stream') }}
                        {% if count_streams %}
                            {{ t('%d stream', '%d streams', count_streams, [count_streams]) }}
                        {% else %}
                            {{ t('No stream') }}
                        {% endif %}
                    </span>
                {% endif %}
            </p>
        </div>
    </div>

    {% if action === 'add' %}
        <form
            class="text--right"
            method="post"
            action="{{ url('add stream source', { id: stream.id, source_id: source.id }) }}"
        >
            <button>
                {{ t('Add') }}
            </button>

            <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\AddSource') }}" />
        </form>
    {% elseif action === 'remove' %}
        <form
            class="text--right"
            method="post"
            action="{{ url('remove stream source', { id: stream.id, source_id: source.id }) }}"
        >
            <button>
                {{ t('Remove') }}
            </button>

            <input type="hidden" name="csrf_token" value="{{ csrf_token('streams\\RemoveSource') }}" />
        </form>
    {% endif %}
</article>
