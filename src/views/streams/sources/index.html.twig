{% extends 'layouts/application.html.twig' %}

{% set title = t('Sources of %s', [stream.name]) %}

{% block title %}{{ title }}{% endblock %}
{% block canonical %}{{ url_full('stream sources', { id: stream.id }) }}{% endblock %}

{% block head_additional_tags %}
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
{% endblock %}

{% block layout_header %}
    {{ include('layouts/_header.html.twig', { page: 'stream sources', tab: 'reading' }) }}
{% endblock %}

{% block back %}
    {{ include('layouts/_back.html.twig', { title: title }) }}
{% endblock %}

{% block body %}
    <h1 class="text--center">{{ title }}</h1>

    <p class="text--center">
        <a class="button button--big button--primary button--animated" href="{{ url('stream', { id: stream.id }) }}">
            {{ t('Continue to the stream') }}
            {{ icon('arrow-right') }}
        </a>
    </p>

    <section
        class="sources flow"
        data-controller="filter focus morph selection"
        data-morph-preserve-value="data-selection-mode"
        data-action="
            turbo:morph@document->filter#filter
            turbo:morph@document->selection#clear
            turbo:before-morph-attribute->morph#preserveAttributes
            filter:filtered->selection#uncheckHidden
            submit->focus#remember
            turbo:render@document->focus#restore
        "
    >
        {% if sources %}
            {{ include('sources/_filters.html.twig', { id: 'stream-sources-filters' }) }}

            <p class="text--center" role="status">
                <span data-filter-target="count"></span>
                {{ t('%d source', '%d sources', sources | length, [sources | length]) }}
            </p>

            <div class="panel panel--large panel--rounded flow flow--large">
                {{ include('sources/_bulk_bar.html.twig') }}

                <div class="flow">
                    {% for source in sources %}
                        {{ include('sources/_source.html.twig', { selectable: true }) }}
                    {% endfor %}
                </div>

                <p class="text--center text--secondary" data-filter-target="empty" hidden>
                    {{ t('No source matches your filters.') }}
                </p>
            </div>
        {% else %}
            <p class="text--center text--secondary">
                {{ t('This list is empty.') }}
            </p>
        {% endif %}
    </section>
{% endblock %}
