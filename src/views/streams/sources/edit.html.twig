{% extends 'layouts/application.html.twig' %}

{% set title = t('Sources of %s', [stream.name]) %}

{% block title %}{{ title }}{% endblock %}
{% block canonical %}{{ url_full('edit stream sources', { id: stream.id }) }}{% endblock %}

{% block head_additional_tags %}
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
{% endblock %}

{% block layout_header %}
    {{ include('layouts/_header.html.twig', { page: 'stream sources', tab: 'reading' }) }}
{% endblock %}

{% block back %}
    {{ include('layouts/_back.html.twig', { title: title }) }}
{% endblock %}

{% block body %}
    <h1 class="text--center">{{ title }}</h1>

    <p class="text--center">
        {{ t('Add or remove sources to customise your stream.') }}
    </p>

    <p class="text--center">
        <a class="button button--big button--primary button--animated" href="{{ url('stream', { id: stream.id }) }}">
            {{ t('Continue to the stream') }}
            {{ icon('arrow-right') }}
        </a>
    </p>

    <div class="sources flow">
        <div class="cols cols--gap cols--start">
            <div class="col--size6">
                {{ include('streams/sources/_selector.html.twig', {
                    id: 'sources-suggested',
                    title: t('Suggested sources'),
                    sources: suggested_sources,
                    action: 'add',
                    with_flags: true,
                }) }}
            </div>

            <div class="col--size6">
                {{ include('streams/sources/_selector.html.twig', {
                    id: 'stream-sources',
                    title: t('Sources of the stream'),
                    sources: stream.sources({ context_user: app.user }),
                    action: 'remove',
                    frequency: stream.publicationFrequencyPerYear({ context_user: app.user }),
                    add_feed_url: url('new stream source feed', { id: stream.id }),
                }) }}
            </div>
        </div>
    </div>
{% endblock %}
