{% extends 'layouts/modal.html.twig' %}

{% block title %}{{ t('Stream illustration') }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--large">
        <div class="text--center flow flow--small">
            <p class="text--bold">{{ stream.name }}</p>

            <p>
                {{ t('Illustrations help to distinguish your stream among the others.') }}
            </p>
        </div>

        {{ include('components/image_upload.html.twig', {
            form: form,
            action: url('update image stream', { id: stream.id }),
            field: 'image',
        }) }}
    </div>
{% endblock %}
