{% extends 'layouts/base.html.twig' %}

{% block layout_body %}
    <div>
        <section class="layout__content layout__content--application">
            {# The layout_sidenav block is rendered by the base layout. #}
            {{ layout_sidenav }}

            <div class="layout__column">
                <div class="wrapper wrapper--large wrapper--center">
                    {% block search %}
                    {% endblock %}

                    {% block back %}
                    {% endblock %}
                </div>

                <div id="main-content" class="layout__body layout__body--large" tabindex="-1">
                    {% block body %}
                    {% endblock %}
                </div>
            </div>
        </section>
    </div>
{% endblock %}
