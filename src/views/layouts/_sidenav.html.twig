<div id="main-navigation" class="sidenav" data-controller="sidenav" tabindex="-1">
    <button
        type="button"
        class="sidenav__open-button button--big button--block"
        data-action="sidenav#open"
        data-sidenav-target="opener"
        aria-expanded="false"
    >
        {{ icon('bars') }}
        {{ navigation.title }}
    </button>

    <div class="sidenav__container" data-action="click->sidenav#closeOnMask">
        <nav class="sidenav__menu" aria-label="{{ navigation.title }}">
            <div class="sidenav__inner">
                <div class="text--right">
                    <button
                        type="button"
                        class="sidenav__close-button button--icon"
                        data-action="sidenav#close"
                        data-sidenav-target="closer"
                    >
                        {{ icon('times') }}
                        <span class="sr-only">
                            {{ t('Close') }}
                        </span>
                    </button>
                </div>

                <div class="flow flow--smaller">
                    {% for element in navigation.elements %}
                        {{ include('layouts/_sidenav_element.html.twig') }}
                    {% endfor %}
                </div>
            </div>
        </nav>
    </div>
</div>
