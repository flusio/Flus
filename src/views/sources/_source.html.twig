{% set count_streams = source.countStreamsByUser(app.user) %}
{% set time_filter = source.timeFilterByUser(app.user) %}

{% set time_filter_labels = {
    'none': t('no links'),
    'strict': t('last 24 hours'),
    'normal': t('last 7 days'),
    'all': t('all the links'),
} %}

{# The publication frequency is the information behind the suggested time
 # filter. The suggestion doesn't distinguish the inactive sources from the
 # quiet ones, so they are told apart here. #}
{% set frequency_flags = {
    'all': 'frequency-quiet',
    'normal': 'frequency-weekly',
    'strict': 'frequency-daily',
    'none': 'frequency-prolific',
} %}

{% if source.publication_frequency_per_year == 0 %}
    {% set frequency_flag = 'frequency-inactive' %}
{% else %}
    {% set frequency_flag = frequency_flags[source.suggestedTimeFilter] %}
{% endif %}

{# The time filter is compared to what Flus suggests for this publication rate:
 # a source is flagged as soon as it diverges. #}
{% if time_filter and time_filter != source.suggestedTimeFilter %}
    {% set recommendation_flag = 'off-recommendation' %}
{% else %}
    {% set recommendation_flag = '' %}
{% endif %}

{% set flags = [
    count_streams ? '' : 'without-stream',
    source.isFeed ? 'type-feed' : 'type-collection',
    frequency_flag,
    recommendation_flag,
] %}

{# A source can be searched by everything that is displayed about it: its name,
 # and the website of a feed or the publishers of a collection. #}
{% if source.isFeed %}
    {% set search_terms = [source.name, source.feedWebsiteHost] %}
{% else %}
    {% set search_terms = [source.name] | merge(source.publishers | column('username')) %}
{% endif %}

<article
    id="source-{{ source.id }}"
    class="source cols cols--center cols--gap"
    tabindex="-1"
    data-filter-target="item"
    data-focus-target="item"
    data-search="{{ search_terms | json_encode }}"
    data-flags="{{ flags | join(' ') }}"
>
    <div class="col--extend cols cols--always cols--center cols--gap">
        <a
            class="source__image-container col--noshrink"
            tabindex="-1"
            href="{{ url('collection', { id: source.id }) }}"
        >
            <img
                class="source__image"
                alt=""
                src="{{ url_media('covers', source.image_filename, 'collection-card.png') }}"
            >
        </a>

        <div class="source__content col--extend flow flow--smaller">
            <h3 class="text--bold text--normal">
                <a class="anchor--nostyle" href="{{ url('collection', { id: source.id }) }}">
                    {{ source.name }}
                </a>
            </h3>

            <p class="text--secondary">
                {% if source.isFeed %}
                    <span title="{{ t('Feed of %s website', [source.feedWebsiteHost]) }}">
                        {{ source.feedWebsiteHost }}
                    </span>
                {% else %}
                    {{ t('By') }}
                    {%- for user in source.publishers -%}
                        {% if not loop.first %}, {% endif %}
                        <a class="username" href="{{ url('profile', { id: user.id }) }}">
                            <img class="avatar avatar--mini" alt="" src="{{ url_avatar(user.avatar_filename) }}">
                            {{- user.username -}}
                        </a>
                    {%- endfor -%}
                {% endif %}
            </p>

            <p class="text--secondary stack stack--gap">
                <span title="{{ t('Publication frequency') }}">
                    {{ icon('frequency') }}
                    {{ source.publication_frequency_per_year | format_publication_frequency }}
                </span>

                {% if time_filter %}
                    <span title="{{ t('Links received in the news') }}">
                        {{ icon('news') }}
                        {{ time_filter_labels[time_filter] }}
                    </span>
                {% endif %}

                <span title="{{ t('Streams displaying this source') }}">
                    {{ icon('stream') }}
                    {% if count_streams %}
                        {{ t('%d stream', '%d streams', count_streams, [count_streams]) }}
                    {% else %}
                        {{ t('No stream') }}
                    {% endif %}
                </span>
            </p>
        </div>
    </div>

    <div class="cols cols--always cols--center cols--gap-smaller">
        <div class="col--extend"></div>

        <button
            data-controller="modal-opener"
            data-action="modal-opener#fetch focus#rememberSelf"
            data-modal-opener-href-value="{{ url('edit collection follow', { id: source.id }) }}"
            aria-haspopup="dialog"
            aria-controls="modal"
        >
            {{ icon('slider') }}
            {{ t('Manage the subscription') }}
        </button>

        {% embed 'components/popup.html.twig' with {
            opener_class: 'button button--icon',
            position: 'right',
            tooltip: t('Actions on %s', [source.name]),
        } %}
            {% block opener %}
                {{ icon('menu') }}

                <span class="sr-only">
                    {{ t('Actions on %s', [source.name]) }}
                </span>
            {% endblock %}

            {% block items %}
                {% import _self as item %}

                {{ item.clipboard(
                    value: url_full('collection', { id: source.id }),
                    label: t('Copy link to collection'),
                ) }}

                {{ item.clipboard(
                    value: url_full('collection feed', { id: source.id }),
                    label: t('Copy link to Web feed'),
                    icon: 'feed',
                ) }}

                {{ item.separator() }}

                {# Unfollowing deletes the follow, which removes the source from
                 # the streams as well: better warn the user. #}
                {{ item.action(
                    url: url('unfollow collection', { id: source.id }),
                    label: t('Unfollow'),
                    icon: 'disconnect',
                    csrf: 'collections\\UnfollowCollection',
                    confirm: count_streams > 0 ? t(
                        'Are you sure that you want to unfollow this source? It will be removed from %d stream.',
                        'Are you sure that you want to unfollow this source? It will be removed from %d streams.',
                        count_streams,
                        [count_streams],
                    ) : '',
                ) }}
            {% endblock %}
        {% endembed %}
    </div>
</article>
