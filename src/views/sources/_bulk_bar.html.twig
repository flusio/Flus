{# Bar of the actions applying to a selection of sources.
 #
 # It must be placed inside an element controlled by the "selection" Stimulus
 # controller, next to a list of selectable sources (see sources/_source.html.twig).
 # Out of the selection mode, it only displays the button entering the mode.
 #
 # On the page of a stream, `stream` enables the action removing the selection
 # from this stream, and excludes it from the list of the streams to add to. #}

{% set stream = stream ?? null %}

<div
    class="sources__bulk"
    data-controller="sticky morph"
    data-morph-preserve-value="data-stuck"
    data-action="turbo:before-morph-attribute->morph#preserveAttributes"
>
    <p class="sources__bulk-start">
        <button data-selection-target="start" data-action="selection#start">
            {{ icon('check') }}
            {{ t('Select…') }}
        </button>
    </p>

    <div class="sources__bulk-bar flow">
        <div class="cols cols--always cols--center cols--gap-small">
            <div class="sources__bulk-select col--extend stack stack--gap-small">
                <div class="cols cols--always cols--center">
                    <input
                        type="checkbox"
                        id="bulk-sources-select-all"
                        data-selection-target="selectAll"
                        data-action="selection#toggleAll"
                    >

                    <label for="bulk-sources-select-all">
                        {{ t('Select all') }}
                    </label>
                </div>

                <span class="sources__bulk-counter text--secondary" role="status">
                    ({{ t('selection:') }} <span data-selection-target="counter">0</span>)
                </span>
            </div>

            <button
                type="button"
                class="button--icon button--ghost"
                data-action="selection#stop"
            >
                {{ icon('times') }}

                <span class="sr-only">
                    {{ t('Cancel') }}
                </span>
            </button>
        </div>

        <div class="sources__bulk-actions stack stack--gap-small">
            <div data-selection-target="popup" inert>
                {% embed 'components/popup.html.twig' %}
                    {% block opener %}
                        {{ icon('news') }}
                        {{ t('News filter') }}
                        {{ icon('angle-down') }}
                    {% endblock %}

                    {% block items %}
                        {% import _self as item %}

                        {{ item.heading(t('Which links to receive in the news?')) }}

                        {% for time_filter, label in {
                            'none': t('No link'),
                            'strict': t('The links published during the last 24 hours'),
                            'normal': t('The links published during the last 7 days'),
                            'all': t('All the published links'),
                        } %}
                            {{ item.action(
                                url: url('update sources time filter'),
                                label: label,
                                form: 'bulk-sources-form',
                                attrs: { name: 'time_filter', value: time_filter },
                            ) }}
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            </div>

            {% set addable_streams = app.user.streams | filter(s => stream == null or s.id != stream.id) %}
            {% set filterable_streams = addable_streams | length > 10 %}

            {% if addable_streams %}
                <div
                    data-selection-target="popup"
                    inert
                    {% if filterable_streams %}
                        data-controller="filter"
                    {% endif %}
                >
                    {% embed 'components/popup.html.twig' %}
                        {% block opener %}
                            {{ icon('plus') }}
                            {{ t('Add to a stream') }}
                            {{ icon('angle-down') }}
                        {% endblock %}

                        {% block items %}
                            {% import _self as item %}

                            {{ item.heading(t('In which stream to add the sources?')) }}

                            {% if filterable_streams %}
                                <input
                                    type="search"
                                    placeholder="{{ t('Filter the streams…') }}"
                                    aria-label="{{ t('Filter the streams') }}"
                                    autocomplete="off"
                                    data-filter-target="search"
                                    data-action="input->filter#filter"
                                >
                            {% endif %}

                            {% for addable_stream in addable_streams %}
                                {{ item.action(
                                    url: url('add stream sources', { id: addable_stream.id }),
                                    label: addable_stream.name,
                                    form: 'bulk-sources-form',
                                    attrs: filterable_streams ? {
                                        'data-filter-target': 'item',
                                        'data-search': [addable_stream.name] | json_encode,
                                    } : {},
                                ) }}
                            {% endfor %}

                            {% if filterable_streams %}
                                <p class="text--center text--secondary" data-filter-target="empty" hidden>
                                    {{ t('No stream matches your search.') }}
                                </p>
                            {% endif %}
                        {% endblock %}
                    {% endembed %}
                </div>
            {% endif %}

            {% if stream %}
                <button
                    type="submit"
                    form="bulk-sources-form"
                    formaction="{{ url('remove stream sources', { id: stream.id }) }}"
                    data-selection-target="button"
                    data-turbo-confirm="{{ t('Are you sure that you want to remove the selected sources from this stream?') }}"
                    disabled
                >
                    {{ icon('times') }}
                    {{ t('Remove from this stream') }}
                </button>
            {% endif %}

            <button
                type="submit"
                form="bulk-sources-form"
                formaction="{{ url('unfollow sources') }}"
                data-selection-target="button"
                data-turbo-confirm="{{ t('Are you sure that you want to unfollow the selected sources? They will be removed from all your streams.') }}"
                disabled
            >
                {{ icon('disconnect') }}
                {{ t('Unfollow') }}
            </button>

            <form id="bulk-sources-form" method="post">
                <input type="hidden" name="csrf_token" value="{{ csrf_token('sources\\BulkSelection') }}">
            </form>
        </div>
    </div>
</div>
