{% extends 'layouts/modal.html.twig' %}

{% block title %}{{ t('Source illustration') }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--large">
        <div class="text--center flow flow--small">
            <p class="text--bold">{{ source.nameByUser(app.user) }}</p>

            <p>
                {{ t('Illustrations help to distinguish this source among the others. Only you will see it.') }}
            </p>
        </div>

        {{ include('components/image_upload.html.twig', {
            form: form,
            action: url('update source follow image', { id: source.id }),
            field: 'image',
        }) }}
    </div>
{% endblock %}
