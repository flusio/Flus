{% extends 'layouts/application.html.twig' %}

{% block title %}{{ t('Sources') }}{% endblock %}
{% block canonical %}{{ url_full('sources') }}{% endblock %}

{% block head_additional_tags %}
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
{% endblock %}

{% block layout_header %}
    {{ include('layouts/_header.html.twig', { page: 'sources', tab: 'reading' }) }}
{% endblock %}

{% block layout_sidenav %}
    {{ include('layouts/_sidenav.html.twig', { navigation: reading_navigation(current: 'sources') }) }}
{% endblock %}

{% block back %}
    {{ include('layouts/_back.html.twig', { title: t('Sources'), reset: true }) }}
{% endblock %}

{% block body %}
    {% set importation = importation_form.currentImportation %}

    <h1 class="text--center">{{ t('Sources') }}</h1>

    <p class="text--center">
        {{ t('The collections and the feeds that you follow feed both your journal and your streams.') }}
    </p>

    <div class="panel panel--rounded stack stack--gap-small">
        <button
            class="button--primary"
            data-controller="modal-opener"
            data-action="modal-opener#fetch"
            data-modal-opener-selector-value="{{ url('new feed') }}"
            aria-haspopup="dialog"
            aria-controls="modal"
        >
            {{ icon('plus-circle') }}
            {{ t('Add a feed') }}
        </button>

        <form
            method="post"
            action="{{ url('import sources opml') }}"
            enctype="multipart/form-data"
            data-controller="autosubmit form-file"
        >
            <input type="hidden" name="csrf_token" value="{{ csrf_token(importation_form) }}">

            <input
                type="file"
                name="opml"
                accept="{{ importation_form.acceptedMimetypes }}"
                data-action="autosubmit#submit"
                data-form-file-target="file"
                hidden
            >

            <button
                type="button"
                data-action="form-file#openFile"
                data-autosubmit-target="actionButton"
                {{ importation ? 'disabled' }}
            >
                {{ icon('upload') }}
                {{ t('Import OPML') }}
            </button>
        </form>

        {% if sources %}
            <a class="button" href="{{ url('sources opml') }}" download data-turbo="false">
                {{ icon('cloud-download') }}
                {{ t('Download OPML') }}
            </a>
        {% endif %}
    </div>

    {{ include('importations/_importation.html.twig') }}

    <section
        class="sources flow"
        data-controller="filter focus morph selection"
        data-morph-preserve-value="data-selection-mode"
        data-action="
            turbo:morph@document->filter#filter
            turbo:morph@document->selection#clear
            turbo:before-morph-attribute->morph#preserveAttributes
            filter:filtered->selection#uncheckHidden
            submit->focus#remember
            turbo:render@document->focus#restore
        "
    >
        {% if sources %}
            {{ include('sources/_filters.html.twig', {
                id: 'sources-filters',
                display_subscription_filters: true,
            }) }}

            <p class="text--center" role="status">
                <span data-filter-target="count"></span>
                {{ t('%d source', '%d sources', sources | length, [sources | length]) }}
            </p>

            <div class="panel panel--rounded flow">
                {{ include('sources/_bulk_bar.html.twig') }}

                <div class="flow">
                    {% for source in sources %}
                        {{ include('sources/_source.html.twig', { selectable: true }) }}
                    {% endfor %}
                </div>

                <p class="text--center text--secondary" data-filter-target="empty" hidden>
                    {{ t('No source matches your filters.') }}
                </p>
            </div>
        {% else %}
            <p class="text--center text--secondary">
                {{ t('This list is empty.') }}
            </p>
        {% endif %}
    </section>
{% endblock %}
