{% extends 'layouts/application.html.twig' %}

{% block title %}{{ t('Sources') }}{% endblock %}
{% block canonical %}{{ url_full('sources') }}{% endblock %}

{% block head_additional_tags %}
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
{% endblock %}

{% block layout_header %}
    {{ include('layouts/_header.html.twig', { page: 'sources', tab: 'reading' }) }}
{% endblock %}

{% block layout_sidenav %}
    {{ include('layouts/_sidenav.html.twig', { navigation: reading_navigation(current: 'sources') }) }}
{% endblock %}

{% block back %}
    {{ include('layouts/_back.html.twig', { title: t('Sources'), reset: true }) }}
{% endblock %}

{% block body %}
    <h1 class="text--center">{{ t('Sources') }}</h1>

    <p class="text--center">
        {{ t('The collections and the feeds that you follow feed both your news and your streams.') }}
    </p>

    <p class="text--center">
        <button
            class="button--primary button--big"
            data-controller="modal-opener"
            data-action="modal-opener#fetch"
            data-modal-opener-href-value="{{ url('new feed') }}"
            aria-haspopup="dialog"
            aria-controls="modal"
        >
            {{ icon('plus-circle') }}
            {{ t('Add a feed') }}
        </button>
    </p>

    <section
        class="sources flow"
        data-controller="filter focus"
        data-action="
            turbo:morph@document->filter#filter
            submit->focus#remember
            turbo:render@document->focus#restore
        "
    >
        {% if sources %}
            <details
                class="filters"
                id="sources-filters"
                data-turbo-permanent
                open
                data-controller="details"
                data-details-storage-key-value="sources-filters"
            >
                <summary
                    class="details__header cols cols--always cols--center cols--gap-small"
                    data-focus-target="fallback"
                    data-action="click->details#toggle"
                >
                    {{ icon('angle-down', 'details__chevron') }}

                    <span class="col--extend text--bold">{{ t('Filters') }}</span>
                </summary>

                <div class="filters__section">
                    <div class="cols cols--gap-small cols--center">
                        <label class="col--size2" for="sources-filter-query">
                            {{ t('Keywords') }}
                        </label>

                        <input
                            id="sources-filter-query"
                            class="col--size10"
                            type="search"
                            placeholder="{{ t('Name, website or author') }}"
                            autocomplete="off"
                            data-filter-target="search"
                            data-action="input->filter#filter"
                        >
                    </div>
                </div>

                <div class="filters__section">
                    <div class="cols cols--gap-small cols--center">
                        <label class="col--size2" for="sources-filter-frequency">
                            {{ t('Frequency') }}
                        </label>

                        <div class="col--size10">
                            <select
                                id="sources-filter-frequency"
                                data-filter-target="flag"
                                data-action="filter#filter"
                            >
                                <option value="">{{ t('All the publication frequencies') }}</option>
                                <option value="frequency-inactive">{{ t('Inactive (no link over the past year)') }}</option>
                                <option value="frequency-quiet">{{ t('Occasional (less than 1 link per week)') }}</option>
                                <option value="frequency-weekly">{{ t('Weekly (1 to 7 links per week)') }}</option>
                                <option value="frequency-daily">{{ t('Daily (1 to 2 links per day)') }}</option>
                                <option value="frequency-prolific">{{ t('Prolific (3 links per day or more)') }}</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="filters__section">
                    <div class="cols cols--gap-small cols--center">
                        <p class="col--size2 text--bold" id="sources-filter-type-label">
                            {{ t('Type') }}
                        </p>

                        <div
                            class="col--size10 stack stack--gap-small"
                            role="group"
                            aria-labelledby="sources-filter-type-label"
                        >
                            {% for flag, label in {
                                '': t('All'),
                                'type-collection': t('Collections only'),
                                'type-feed': t('Feeds only'),
                            } %}
                                <div class="filters__option">
                                    <button
                                        type="button"
                                        aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                                        value="{{ flag }}"
                                        data-filter-target="flag"
                                        data-action="filter#selectFlag"
                                    >
                                        {{ label }}
                                    </button>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="filters__section">
                    <div class="cols cols--gap-small cols--center">
                        <div class="col--size2"></div>

                        <div class="col--size10 flow flow--small">
                            <div>
                                <input
                                    type="checkbox"
                                    id="sources-filter-without-stream"
                                    data-filter-target="flag"
                                    value="without-stream"
                                    data-action="filter#filter"
                                >

                                <label for="sources-filter-without-stream">
                                    {{ t('Only the sources in no stream') }}
                                </label>
                            </div>

                            <div>
                                <input
                                    type="checkbox"
                                    id="sources-filter-off-recommendation"
                                    data-filter-target="flag"
                                    value="off-recommendation"
                                    data-action="filter#filter"
                                >

                                <label for="sources-filter-off-recommendation">
                                    {{ t('Only the sources that differ from the recommendation for the news') }}
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </details>

            <div class="panel panel--large panel--rounded flow flow--large">
                <p class="text--center" role="status">
                    <span data-filter-target="count"></span>
                    {{ t('%d source', '%d sources', sources | length, [sources | length]) }}
                </p>

                <div class="flow">
                    {% for source in sources %}
                        {{ include('sources/_source.html.twig') }}
                    {% endfor %}
                </div>

                <p class="text--center text--secondary" data-filter-target="empty" hidden>
                    {{ t('No source matches your filters.') }}
                </p>
            </div>
        {% else %}
            <p class="text--center text--secondary">
                {{ t('This list is empty.') }}
            </p>
        {% endif %}
    </section>
{% endblock %}
