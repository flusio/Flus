{% extends 'layouts/onboarding.html.twig' %}

{% block title %}{{ t('Organise your monitoring') }}{% endblock %}
{% block canonical %}{{ url_full('onboarding', { step: 3 }) }}{% endblock %}

{% block navigation %}
    {{ include('onboarding/_navigation.html.twig') }}
{% endblock %}

{% block body %}
    <h1 class="text--center">{{ t('Organise your monitoring') }}</h1>

    <p class="text--center">
        {{ icon('stream') }}
        {{ t('The <strong>Streams</strong> group the sources that you follow into thematic timelines.') | raw }}
    </p>

    <div class="flow">
        <p>
            {{ t('A source can be a collection shared by another user, or almost any website <strong>as long as it offers a Web feed</strong>: news sites, blogs, podcasts… Even YouTube channels!') | raw }}
        </p>

        <p>
            {{ t('Create a stream per topic to keep up with your sources at your own pace, without cluttering your news.') }}
        </p>
    </div>

    {{ include('onboarding/_continue.html.twig') }}
{% endblock %}
