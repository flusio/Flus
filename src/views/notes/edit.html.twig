{% extends 'layouts/application.html.twig' %}

{% block title %}{{ t('Note edition') }}{% endblock %}

{% block back %}
    {{ include('layouts/_back.html.twig', { title: t('Note edition') }) }}
{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--large">
        <h1 class="text--center">{{ t('Note edition') }}</h1>

        <div class="notepad">
            <turbo-frame id="note-{{ note.id }}" target="_top">
                <article class="notepad__note notepad__note--editing">
                    {{ include('notes/_note_header.html.twig', { note: note }) }}

                    <form
                        method="post"
                        action="{{ url('update note', { id: note.id }) }}"
                        data-turbo-frame="note-{{ note.id }}"
                        data-controller="autosave"
                        data-action="turbo:submit-start@document->autosave#clear"
                        class="notepad__form flow"
                    >
                        {{ include('alerts/_error.html.twig', { message: form.error('@base') }) }}

                        {{ include('notes/_note_field.html.twig', {
                            form: form,
                            id: 'note-' ~ note.id ~ '-content',
                            name: 'content',
                            label: t('Your note'),
                            required: true,
                            autofocus: true,
                            display_submit: true,
                            submit_label: t('Save'),
                            cancel_url: url('link', { id: note.link_id }) ~ '#note-' ~ note.id,
                            cancel_turbo_frame: 'note-' ~ note.id,
                        }) }}

                        <input type="hidden" name="csrf_token" value="{{ csrf_token(form) }}">
                    </form>
                </article>
            </turbo-frame>
        </div>
    </div>
{% endblock %}
