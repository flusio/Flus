{% set display_actions = display_actions ?? false %}

<article class="notepad flow">
    {% for date_iso, notes in notepad %}
        {% set date = date(date_iso) %}

        <div id="notepad-{{ date_iso }}" class="notepad__container">
            <p class="notepad__header">
                <a class="notepad__date" href="#notepad-{{ date_iso }}">
                    <time datetime="{{ date_iso }}">
                        {{ d(date, 'dd MMMM y') }}
                    </time>
                </a>
            </p>

            {% for note in notes %}
                <div class="notepad__note cols cols--gap-smaller">
                    <div class="notepad__content text-container col--extend">
                        {{ note.contentAsHtml | raw }}
                    </div>

                    {% if display_actions and app.user and note.user_id === app.user.id %}
                        <div class="text--right">
                            {% embed 'components/popup.html.twig' with {
                                opener_class: 'button button--ghost button--icon',
                                position: 'right',
                                tooltip: t('Actions'),
                            } %}
                                {% block opener %}
                                    {{ icon('menu') }}

                                    <span class="sr-only">
                                        {{ t('Actions') }}
                                    </span>
                                {% endblock %}

                                {% block items %}
                                    {% import _self as item %}

                                    {{ item.modal(
                                        url: url('edit note', { id: note.id }),
                                        label: t('Edit'),
                                        icon: 'pencil',
                                    ) }}

                                    {{ item.separator() }}

                                    {{ item.action(
                                        url: url('delete note', { id: note.id }),
                                        label: t('Delete'),
                                        icon: 'trash',
                                        csrf: 'notes\\DeleteNote',
                                        confirm: t('Are you sure that you want to delete this note?'),
                                        preserve_scroll: true,
                                    ) }}
                                {% endblock %}
                            {% endembed %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endfor %}
</article>
