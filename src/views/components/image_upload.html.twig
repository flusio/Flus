{% set button_label = button_label ?? t('Upload an image') %}
{% set button_class = button_class ?? 'button--primary button--big' %}

<form
    method="post"
    action="{{ action }}"
    data-controller="autosubmit form-file"
    enctype="multipart/form-data"
    class="flow text--center"
>
    {{ include('alerts/_error.html.twig', { message: form.error('@base') }) }}

    {% if form.isInvalid(field) %}
        <p id="{{ field }}-error" class="form-group__error text--center">
            {{ t('Error:') }}
            {{ form.error(field) }}
        </p>
    {% endif %}

    <input
        type="file"
        name="{{ field }}"
        id="{{ field }}"
        accept="{{ form.imageAcceptedMimetypes(field) }}"
        data-action="autosubmit#submit"
        data-form-file-target="file"
        hidden
    >

    <div class="form__actions">
        <button
            type="button"
            class="{{ button_class }}"
            data-action="form-file#openFile"
            data-autosubmit-target="actionButton"
            aria-describedby="{{ field }}-caption"
            {% if form.isInvalid(field) %}
                aria-errormessage="{{ field }}-error"
                aria-invalid="true"
            {% endif %}
        >
            {{ button_label }}
        </button>
    </div>

    <p id="{{ field }}-caption" class="form-group__caption text--centered">
        {{ t('<abbr>PNG</abbr>, <abbr>JPG</abbr> and <abbr>WEBP</abbr> images only.') | raw }}<br />
        {{ t('The minimum recommended dimensions are %sx%spx.', [400, 400]) }}
    </p>

    <input type="hidden" name="csrf_token" value="{{ csrf_token(form) }}" />
</form>
