{#
 # The actions on the journal links, to be included in the `items` block of
 # a popup. `params` is added as hidden inputs to each form, to restrict the
 # actions to a subset of the journal.
 #}
{% import 'components/popup.html.twig' as item %}

{% types {
    heading: 'string',
    params: 'array',
    preserve_scroll: 'boolean',
} %}

{% set params = params ?? {} %}
{% set preserve_scroll = preserve_scroll ?? false %}

{{ item.heading(heading) }}

{{ item.action(
    url: url('mark collection as read', { id: journal.id }),
    label: t('Mark all as read'),
    icon: 'check',
    csrf: 'collections\\MarkCollectionAsRead',
    params: params,
    preserve_scroll: preserve_scroll,
) }}

{{ item.action(
    url: url('read collection later', { id: journal.id }),
    label: t('Read the links later'),
    icon: 'bookmark',
    csrf: 'collections\\MarkCollectionAsReadLater',
    params: params,
    preserve_scroll: preserve_scroll,
) }}

{{ item.separator() }}

{{ item.action(
    url: url('dismiss collection', { id: journal.id }),
    label: t('Ignore the links'),
    icon: 'times',
    csrf: 'collections\\MarkCollectionAsDismissed',
    params: params,
    preserve_scroll: preserve_scroll,
    confirm: t('The links will no longer be counted as unread and won’t be suggested in your journal. Are you sure?'),
) }}
