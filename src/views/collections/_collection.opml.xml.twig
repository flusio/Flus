{% set with_time_filter = with_time_filter ?? true %}
{% set time_filter = with_time_filter ? collection.timeFilterByUser(user) : null %}
{% set display_time_filter = time_filter and time_filter != 'normal' %}

{% if collection.isFeed %}
    {% set html_url = collection.feed_site_url %}
{% else %}
    {% set html_url = url_full('collection', { id: collection.id }) %}
{% endif %}

<outline
    type="rss"
    text="{{ collection.name() }}"
    xmlUrl="{{ collection.feedUrl(true) }}"
    htmlUrl="{{ html_url }}"
    {% if display_time_filter %}
        category="/Flus/filters/{{ time_filter }}"
    {% endif %}
/>
