{% set display_by = display_by ?? true %}
{% set display_visibility = display_visibility ?? true %}
{% set display_number_links = display_number_links ?? true %}

<div
    class="collection"
    style="background-image: url('{{ url_media('covers', collection.imageFilenameByUser(app.user), 'collection-card.png') }}');"
    data-color-scheme="dark"
>
    <a class="collection__body flow" href="{{ url('source', { id: collection.id }) }}">
        <div class="collection__title">
            {{ collection.nameByUser(app.user) }}
        </div>

        <div class="flow flow--small">
            <p class="text--oneline">
                {% set by = t('By %s', [collection.owner.username]) %}

                {% if display_number_links %}
                    {% set count_links = collection.countLinksByUser(app.user) %}

                    {% if count_links === 0 %}
                        {% set number_links = t('no links') %}
                    {% else %}
                        {% set number_links = t('%s link', '%s links', count_links, [count_links | format_number]) %}
                    {% endif %}
                {% endif %}

                {% if display_by %}
                    <span class="text--ellipsis">{{ by }}</span>
                {% endif %}

                {% if display_by and display_number_links %}
                    &nbsp;·&nbsp;
                {% endif %}

                {% if display_number_links %}
                    <span class="text--extend">{{ number_links }}</span>
                {% endif %}

                {% if display_visibility %}
                    <span class="badge badge--accent badge--border">
                        {% if collection.is_public %}
                            {{ t('public') }}
                        {% else %}
                            {{ t('private') }}
                        {% endif %}
                    </span>
                {% endif %}
            </p>

            <p title="{{ t('Publication frequency') }}">
                {{ icon('frequency') }}
                {{ collection.publication_frequency_per_year | format_publication_frequency }}
            </p>
        </div>
    </a>
</div>
