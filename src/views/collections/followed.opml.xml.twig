<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
    <head>
        <title>{{ app.brand }}</title>
        <dateCreated>{{ date().format('D, d M Y H:i:s O') }}</dateCreated>
    </head>

    <body>
        {% for source in no_stream_sources %}
            {{ include('collections/_collection.opml.xml.twig', {
                collection: source,
                context_user: user,
            }) }}
        {% endfor %}

        {% for stream in streams %}
            <outline text="{{ stream.name }}">
                {% for source in sources_by_streams[stream.id] ?? [] %}
                    {{ include('collections/_collection.opml.xml.twig', {
                        collection: source,
                        context_user: user,
                    }) }}
                {% endfor %}
            </outline>
        {% endfor %}
    </body>
</opml>
