{#
 # The actions on the news links, to be included in the `items` block of a
 # popup. `params` is added as hidden inputs to each form, to restrict the
 # actions to a subset of the news.
 #}
{% import 'components/popup.html.twig' as item %}

{% types {
    heading: 'string',
    params: 'array',
    preserve_scroll: 'boolean',
} %}

{% set params = params ?? {} %}
{% set preserve_scroll = preserve_scroll ?? false %}

{{ item.heading(heading) }}

{{ item.action(
    url: url('mark collection as read', { id: news.id }),
    label: t('Mark all as read'),
    icon: 'check',
    csrf: 'collections\\MarkCollectionAsRead',
    params: params,
    preserve_scroll: preserve_scroll,
) }}

{{ item.action(
    url: url('read collection later', { id: news.id }),
    label: t('Read the links later'),
    icon: 'bookmark',
    csrf: 'collections\\MarkCollectionAsReadLater',
    params: params,
    preserve_scroll: preserve_scroll,
) }}

{{ item.separator() }}

{{ item.action(
    url: url('never read collection', { id: news.id }),
    label: t('Remove the links from the news'),
    icon: 'times',
    csrf: 'collections\\MarkCollectionAsNever',
    params: params,
    preserve_scroll: preserve_scroll,
    confirm: t('You’ll remove all the news links, this action cannot be canceled. Are you sure?'),
) }}
