{% extends 'layouts/application.html.twig' %}

{% block title %}{{ t('Feeds') }}{% endblock %}
{% block canonical %}{{ url_full('feeds') }}{% endblock %}

{% block layout_header %}
    {{ include('layouts/_header.html.twig', { page: 'feeds', tab: 'feeds' }) }}
{% endblock %}

{% block back %}
    {{ include('layouts/_back.html.twig', { title: t('Feeds'), reset: true }) }}
{% endblock %}

{% block body %}
    <h1 class="text--center">{{ t('Feeds') }}</h1>

    <div class="panel panel--accent panel--larger panel--rounded">
        <div class="wrapper wrapper--text wrapper--center flow flow--large text--center">
            <p class="text--bold">
                {{ icon('info') }}
                {{ t('This page has moved: the feeds and collections that you follow are now listed as “Sources”, in the “Reading” menu.') }}
            </p>

            <p>
                <a class="button button--big button--primary button--animated" href="{{ url('sources') }}">
                    {{ t('Go to the sources') }}
                    {{ icon('arrow-right') }}
                </a>
            </p>
        </div>
    </div>
{% endblock %}
