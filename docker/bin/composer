#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later

SCRIPT_PATH=$(dirname "$(realpath -s "$0")")
export COMPOSE_FILE="$SCRIPT_PATH/../development/docker-compose.yml"
export USER="$(id -u):$(id -g)"

if [ -t 0 ]; then
    TTY_OPTION=""
else
    TTY_OPTION="-T"
fi

if [ -z "$(docker compose ps --status running -q php)" ]; then
    docker compose run --rm $TTY_OPTION php composer "$@"
else
    docker compose exec $TTY_OPTION php composer "$@"
fi
